{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vancefx",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Astro builds the static site into dist/. Requests that match a file are served
  // straight from there; everything else (POST /api/checkout) goes to the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Custom domain. The vancefx.shop zone must be active on Cloudflare before the first deploy.
  "routes": [{ "pattern": "vancefx.shop", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    // "on" once Stripe Tax is set up in the Stripe dashboard.
    "STRIPE_TAX": "off"
  },
  // Secret (not in this file): STRIPE_SECRET_KEY  ->  npx wrangler secret put STRIPE_SECRET_KEY

  "observability": { "enabled": true }
}
